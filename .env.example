# ---- Database ----
# Two roles, deliberately. Row-level security is bypassed by superusers and by
# the table owner, so the API must connect as neither.
#   DATABASE_URL          - the API. Unprivileged, subject to RLS.
#   MIGRATE_DATABASE_URL  - migrations only. Owner, runs DDL.
DATABASE_URL="postgresql://merchforce_app:merchforce_app_dev@localhost:5432/merchforce?schema=public"
MIGRATE_DATABASE_URL="postgresql://merchforce:merchforce@localhost:5432/merchforce?schema=public"

# ---- Object storage (Cloudflare R2 in production, MinIO locally) ----
# R2:    https://<account-id>.r2.cloudflarestorage.com  with region "auto"
# MinIO: http://localhost:9000
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="merchforce"
S3_ACCESS_KEY_ID="merchforce"
S3_SECRET_ACCESS_KEY="merchforce123"
# MinIO needs path-style addressing; R2 accepts it too.
S3_FORCE_PATH_STYLE="true"
# Public base for served objects (an R2 custom domain in production).
S3_PUBLIC_BASE="http://localhost:9000/merchforce"

# ---- Redis / queues ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# openssl rand -hex 32
JWT_SECRET="change-me-32-bytes-minimum-for-hs256-signing"
ACCESS_TOKEN_TTL_SECONDS="1800"
REFRESH_TOKEN_TTL_DAYS="30"

# ---- Server ----
PORT="8901"
NODE_ENV="development"
# Comma-separated origins allowed to call the API.
CORS_ORIGINS="http://localhost:8900,https://rogerdf30.github.io"

# ---- Mail (Resend) ----
# Absent in development: sends report why they did not go instead of pretending.
RESEND_API_KEY=""
MAIL_FALLBACK_FROM="no-reply@merchforce.app"
# Where order.html is served, for the customer links in emails.
PUBLIC_ORDER_URL="http://localhost:8900/order.html"

# Pepper from the Apps Script install being migrated from. Only needed until
# every migrated account has signed in once.
LEGACY_PEPPER=""
