{
  "name": "merchforce",
  "version": "0.2.0",
  "private": true,
  "description": "Merchforce — multi-tenant supplier operations platform",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @merchforce/api dev",
    "db:generate": "pnpm --filter @merchforce/api db:generate",
    "db:migrate": "pnpm --filter @merchforce/api db:migrate",
    "db:deploy": "pnpm --filter @merchforce/api db:deploy",
    "db:seed": "pnpm --filter @merchforce/api db:seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": { "typescript": "^5.6.3" }
}
